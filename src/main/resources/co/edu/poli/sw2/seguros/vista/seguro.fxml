<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefHeight="720.0"
        prefWidth="1180.0"
        stylesheets="@styles.css"
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="co.edu.poli.sw2.ProyectoSeguros.infraestructura.ui.ControlSeguro">

    <!-- ============================= -->
    <!-- CABECERA                      -->
    <!-- ============================= -->

    <top>

        <VBox
                spacing="3"
                styleClass="barra-titulo">

            <Label
                    styleClass="titulo-app"
                    text="Gestion de Seguros" />

            <Label
                    styleClass="subtitulo-app"
                    text="Arquitectura Hexagonal | Seguro de Vida y de Vehiculo | PostgreSQL" />

        </VBox>

    </top>


    <!-- ============================= -->
    <!-- FORMULARIO                    -->
    <!-- ============================= -->

    <left>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                prefWidth="360"
                styleClass="panel-izquierdo">

            <VBox
                    spacing="14">

                <padding>
                    <Insets top="16" right="16" bottom="16" left="16" />
                </padding>


                <VBox
                        spacing="7"
                        styleClass="tarjeta">

                    <Label
                            styleClass="titulo-seccion"
                            text="DATOS DEL SEGURO" />

                    <Label
                            styleClass="etiqueta-campo"
                            text="Tipo de seguro" />

                    <ComboBox
                            fx:id="cmbTipo"
                            maxWidth="Infinity" />

                    <Label
                            styleClass="etiqueta-campo"
                            text="Numero" />

                    <TextField
                            fx:id="txtNumero"
                            promptText="Ej: SEG-0001" />

                    <Label
                            styleClass="etiqueta-campo"
                            text="Fecha de expedicion" />

                    <DatePicker
                            fx:id="dpFecha"
                            maxWidth="Infinity"
                            promptText="aaaa-mm-dd" />

                    <Label
                            styleClass="etiqueta-campo"
                            text="Valor" />

                    <TextField
                            fx:id="txtValor"
                            promptText="Ej: 50000000" />

                    <Label
                            styleClass="etiqueta-campo"
                            text="Estado" />

                    <ComboBox
                            fx:id="cmbEstado"
                            maxWidth="Infinity" />

                    <Label
                            styleClass="etiqueta-campo"
                            text="Asegurado" />

                    <ComboBox
                            fx:id="cmbAsegurado"
                            maxWidth="Infinity"
                            promptText="Seleccione un asegurado" />

                </VBox>


                <!-- Campos propios del seguro de vida -->

                <VBox
                        fx:id="boxVida"
                        spacing="7"
                        styleClass="tarjeta">

                    <Label
                            styleClass="titulo-seccion"
                            text="SEGURO DE VIDA" />

                    <Label
                            styleClass="etiqueta-campo"
                            text="Nombre del beneficiario" />

                    <TextField
                            fx:id="txtBeneficiario"
                            promptText="Ej: Maria Perez" />

                    <Label
                            styleClass="etiqueta-campo"
                            text="Parentesco" />

                    <TextField
                            fx:id="txtParentesco"
                            promptText="Ej: Hija" />

                </VBox>


                <!-- Campos propios del seguro de vehiculo -->

                <VBox
                        fx:id="boxVehiculo"
                        spacing="7"
                        styleClass="tarjeta">

                    <Label
                            styleClass="titulo-seccion"
                            text="SEGURO DE VEHICULO" />

                    <Label
                            styleClass="etiqueta-campo"
                            text="Marca" />

                    <TextField
                            fx:id="txtMarca"
                            promptText="Ej: Mazda" />

                </VBox>


                <!-- ===================== -->
                <!-- CRUD                  -->
                <!-- ===================== -->

                <VBox
                        spacing="10"
                        styleClass="tarjeta">

                    <Label
                            styleClass="titulo-seccion"
                            text="OPERACIONES" />

                    <GridPane
                            hgap="8"
                            vgap="8">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" />
                            <ColumnConstraints percentWidth="50" />
                        </columnConstraints>

                        <Button
                                maxWidth="Infinity"
                                onAction="#crearSeguro"
                                styleClass="boton,boton-primario"
                                text="Crear"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="0" />

                        <Button
                                maxWidth="Infinity"
                                onAction="#modificarSeguro"
                                styleClass="boton,boton-secundario"
                                text="Modificar"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="0" />

                        <Button
                                maxWidth="Infinity"
                                onAction="#eliminarSeguro"
                                styleClass="boton,boton-peligro"
                                text="Eliminar"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="1" />

                        <Button
                                maxWidth="Infinity"
                                onAction="#limpiarFormulario"
                                styleClass="boton,boton-neutro"
                                text="Limpiar"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="1" />

                    </GridPane>

                </VBox>


                <!-- ===================== -->
                <!-- BUSQUEDA              -->
                <!-- ===================== -->

                <VBox
                        spacing="8"
                        styleClass="tarjeta">

                    <Label
                            styleClass="titulo-seccion"
                            text="BUSCAR POR NUMERO" />

                    <TextField
                            fx:id="txtBuscarNumero"
                            promptText="Numero del seguro" />

                    <Button
                            maxWidth="Infinity"
                            onAction="#buscarSeguro"
                            styleClass="boton,boton-secundario"
                            text="Buscar" />

                    <Button
                            maxWidth="Infinity"
                            onAction="#listarSeguros"
                            styleClass="boton,boton-neutro"
                            text="Listar todos" />

                </VBox>


                <Label
                        fx:id="lblMensaje"
                        wrapText="true" />

            </VBox>

        </ScrollPane>

    </left>


    <!-- ============================= -->
    <!-- TABLA                         -->
    <!-- ============================= -->

    <center>

        <VBox
                spacing="10"
                styleClass="tarjeta">

            <BorderPane.margin>
                <Insets top="16" right="16" bottom="16" left="0" />
            </BorderPane.margin>


            <Label
                    styleClass="titulo-seccion"
                    text="SEGUROS REGISTRADOS" />


            <TableView
                    fx:id="tablaSeguros"
                    VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn
                            fx:id="colNumero"
                            prefWidth="100"
                            text="Numero" />

                    <TableColumn
                            fx:id="colTipo"
                            prefWidth="85"
                            text="Tipo" />

                    <TableColumn
                            fx:id="colAsegurado"
                            prefWidth="130"
                            text="Asegurado" />

                    <TableColumn
                            fx:id="colFecha"
                            prefWidth="95"
                            text="Expedicion" />

                    <TableColumn
                            fx:id="colValor"
                            prefWidth="110"
                            text="Valor" />

                    <TableColumn
                            fx:id="colEstado"
                            prefWidth="90"
                            text="Estado" />

                    <TableColumn
                            fx:id="colDetalle"
                            prefWidth="170"
                            text="Beneficiario / Marca" />

                </columns>


                <placeholder>

                    <Label
                            text="No hay seguros registrados." />

                </placeholder>

            </TableView>

        </VBox>

    </center>

</BorderPane>
